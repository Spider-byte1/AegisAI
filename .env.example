# Used by `docker compose` (copy to .env in the repo root). Never commit the real .env.

# REQUIRED. 32+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_to_a_random_32_plus_character_key

# Database password for the bundled PostgreSQL container (any strong value).
POSTGRES_PASSWORD=

# Optional: AI-written answers in the Security Assistant. Empty = passages only.
GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=claude-haiku-4-5-20251001      # a larger model gives richer answers
# ASSISTANT_SCOPE=cybersecurity            # or: general (answer any topic)
LLM_MODEL=openai/gpt-oss-20b

# Keep false unless you deliberately want to scan hosts on your own network from the container.
ALLOW_PRIVATE_TARGETS=false
