# Copy to backend/.env and fill in. Never commit the real .env file.

DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/aegisai_db

# Must be 32+ random chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_to_a_random_32_plus_character_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

ENVIRONMENT=development
LOG_LEVEL=INFO

# Scanning policy
# Keep false unless you are scanning your own lab network (e.g. a VM on 192.168.x.x).
ALLOW_PRIVATE_TARGETS=false
MAX_ACTIVE_SCANS_PER_USER=3
NMAP_TIMEOUT_SECONDS=600

# Security assistant (RAG). Leave GROQ_API_KEY empty to run without AI generation:
# the assistant then shows the most relevant knowledge-base passages instead.
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b
LLM_MAX_TOKENS=1500
# cybersecurity = stay on security topics, general = answer anything
ASSISTANT_SCOPE=cybersecurity
RAG_MAX_QUESTIONS_PER_HOUR=30

CELERY_BROKER_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
